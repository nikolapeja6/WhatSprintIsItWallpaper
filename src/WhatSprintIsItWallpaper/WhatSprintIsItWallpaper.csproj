<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WhatSprintIsItWallpaper</AssemblyName>
    <RootNamespace>WhatSprintIsItWallpaper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Version>1.0.0</Version>
    <Company>WhatSprintIsItWallpaper</Company>
    <Product>WhatSprintIsItWallpaper</Product>
    <Authors>nikolapeja6</Authors>
    <Description>Sets the Windows desktop wallpaper to the current sprint (e.g. 278.1), using the whatsprintis.it formula.</Description>

    <!-- Publish settings are supplied on the command line (see README / CI):
         dotnet publish -c Release -r win-x64 -p:SelfContained=true
           -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
